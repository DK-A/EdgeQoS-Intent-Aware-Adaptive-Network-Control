#!/usr/sbin/nft -f
# dataplane/edgeqos.nft - Production EdgeQoS Netfilter Ruleset
# Tata Elxsi TELIPORT S4 · Problem Statement 3

table inet edgeqos {
  # 5-tuple timed sets with kernel hardware auto-expiration (60s TTL)
  set promo_rt {
    type ipv4_addr . ipv4_addr . inet_proto . inet_service . inet_service;
    flags timeout;
    timeout 60s;
    size 4096;
  }

  set promo_vid {
    type ipv4_addr . ipv4_addr . inet_proto . inet_service . inet_service;
    flags timeout;
    timeout 60s;
    size 4096;
  }

  set promo_blk {
    type ipv4_addr . ipv4_addr . inet_proto . inet_service . inet_service;
    flags timeout;
    timeout 60s;
    size 4096;
  }

  # Host-based temporary intent leases (e.g. 1-hour gaming/conferencing pass)
  set lease_rt {
    type ipv4_addr;
    flags timeout;
    timeout 3600s;
  }

  chain fwd {
    type filter hook forward priority filter; policy accept;

    # C16: Anti-spoofing floor - never trust host-supplied DSCP
    ip dscp set cs0

    # C2: Early flow header inspection only (N <= 10 packets per direction, snaplen = 40B)
    meta l4proto { tcp, udp } ct direction original ct original packets <= 10 log group 100 snaplen 40
    meta l4proto { tcp, udp } ct direction reply    ct reply    packets <= 10 log group 100 snaplen 40

    # C3: diffserv4 marking: EF for Voice, AF41 for Video, CS1 for Bulk
    ip saddr . ip daddr . meta l4proto . th sport . th dport @promo_rt  ip dscp set ef
    ip saddr . ip daddr . meta l4proto . th sport . th dport @promo_vid ip dscp set af41
    ip saddr . ip daddr . meta l4proto . th sport . th dport @promo_blk ip dscp set cs1

    # User Intent Leases
    ip saddr @lease_rt ip dscp set ef
    ip daddr @lease_rt ip dscp set ef
  }
}
